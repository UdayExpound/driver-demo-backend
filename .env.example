# HERE API key (Routing API v8). Server-side only, never ship it in the app
HERE_API_KEY=your-here-api-key

# Truck weight used for HERE truck routing, in kg
TRUCK_GROSS_WEIGHT_KG=40000

PORT=4050

# Pick two real points near you (long-press on a map -> copy the coordinates)
# For walking tests keep pickup 300-800 m away and drop 1-3 km away.
PICKUP_NAME=Plant Gate
PICKUP_LAT=19.03227
PICKUP_LNG=73.04276
DROP_NAME=Customer Site
DROP_LAT=19.0968
DROP_LNG=72.8511
